---
# Template for secrets.yaml (gitignored). Generate the real file from
# 1Password with `task secrets` (scripts/generate_secrets.sh); the
# 1Password reference for each value is noted beside it.

# op://Shared/Home IoT/network name
wifi_ssid: "YOUR_WIFI_SSID_HERE"
# op://Shared/Home IoT/wireless network password
wifi_password: "YOUR_WIFI_PASSWORD_HERE"  # pragma: allowlist secret
# op://Shared/Home IoT/domain name (with a leading dot)
wifi_domain: "YOUR_DOMAIN_HERE"

# API encryption key, also used to encrypt OTA uploads: openssl rand -base64 32
# op://Automation/ESPHome/api_key
api_key: "YOUR_API_ENCRYPTION_KEY_HERE"  # pragma: allowlist secret

# Only needed until the OTA encryption migration is finished (see README)
# op://Automation/ESPHome/ota_password
ota_password: "YOUR_OTA_PASSWORD_HERE"  # pragma: allowlist secret

# Fallback hotspot password, at least 8 characters
# op://Automation/ESPHome/fallback_password
fallback_password: "YOUR_FALLBACK_PASSWORD_HERE"  # pragma: allowlist secret
