{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ESPHome external components pinned as github://owner/repo@tag in live device YAML (not archive/)",
      "managerFilePatterns": ["/^[^/]+\\.ya?ml$/", "/^common/.+\\.ya?ml$/", "/^packages/.+\\.ya?ml$/"],
      "matchStrings": [
        "\\n\\s*-\\s*source:\\s*github://(?<depName>[^/@\\s]+/[^/@\\s]+)@(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["esphome"],
      "matchDatasources": ["pypi"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Keep .python-version on the dev shell's Python (flake.nix python313); esphome caps supported Python, so bump both together by hand",
      "matchManagers": ["pyenv"],
      "allowedVersions": "<3.14"
    },
    {
      "description": "Mitsubishi CN105 component releases need ESPHome compatibility checks",
      "matchPackageNames": ["echavet/MitsubishiCN105ESPHome"],
      "labels": ["dependencies", "heatpump"]
    }
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "pre-commit": {
    "enabled": true
  }
}
